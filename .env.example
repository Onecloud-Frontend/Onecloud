# OneCloud Frontend — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# Backend API base URL (API Gateway or direct service URL)
VITE_API_BASE_URL=

# Application environment
VITE_APP_ENV=development

# Feature flags (optional, set to "true" or "false")
VITE_FEATURE_OAUTH2_ENABLED=false
